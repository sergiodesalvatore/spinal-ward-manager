# Server only: never use a VITE_ prefix for a database password.
DATABASE_URL=postgresql://ROLE:PASSWORD@HOST/DATABASE?sslmode=require
NEON_AUTH_BASE_URL=https://YOUR-AUTH-HOST/neondb/auth
NEON_AUTH_JWKS_URL=https://YOUR-AUTH-HOST/neondb/auth/.well-known/jwks.json
# The Auth URL is public; it contains no credentials.
VITE_NEON_AUTH_URL=https://YOUR-AUTH-HOST/neondb/auth
